{
  "schemaVersion": 1,
  "id": "knick-knacks-justfatlard",
  "version": "${version}",
  "name": "Knick Knacks",
  "description": "Set a loaf, a book or a potion down on a table, a shelf or the floor, and it stays there",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/knick-knacks"
  },
  "license": "MIT",
  "icon": "assets/knick-knacks-justfatlard/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.knick_knacks.Main"
    ]
  },
  "mixins": [
    "knick-knacks-justfatlard.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25"
  },
  "suggests": {
    "block-tip": "*",
    "kragle": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.donate": "https://github.com/sponsors/fatlard1993"
      }
    }
  }
}
